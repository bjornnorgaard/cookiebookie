{
	"name": "cookiebookie",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && vite preview",
		"preview:serve": "vite preview --host 127.0.0.1 --port 4173",
		"audit:seo": "lhci autorun",
		"check": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig tsconfig.json --watch",
		"test": "playwright test"
	},
	"devDependencies": {
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#recipes/*": "./src/recipes/*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"postcss-selector-parser": "^7.1.6",
		"tmp": "^0.2.7",
		"basic-ftp": "^6.2.3",
		"uuid": "^14.0.3",
		"@lhci/cli": {
			"lighthouse": "^13.5.0"
		},
		"@lhci/utils": {
			"lighthouse": "^13.5.0"
		},
		"proxy-agent": "^8.0.2",
		"sprintf-js": "^1.1.3"
	}
}
